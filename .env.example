# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_MB=15

# Embeddings & Vector Store
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIM=384
INDEX_TYPE=IndexFlatIP
INDEX_DIR=data/index
DOCUMENTS_DIR=data/documents

# Retrieval & Gate
TOP_K=4
RELEVANCE_THRESHOLD=0.32

# LLM Provider
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
